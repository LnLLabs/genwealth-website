# Names only. Do not commit a real .env and do not put values in this file.
# Copy this file to .env for local builds. These values are read at build time.

# Public Web3Forms access key. The contact form posts to Web3Forms in the browser.
# Leave empty to keep the site working; the form then tells people to email hello@genwealth.app.
VITE_WEB3FORMS_ACCESS_KEY=

# Canonical site origin, with no trailing slash. Used in RSS, the sitemap, llms.txt, and page metadata.
# https://genwealth.example is the default when this is empty. Set the real hostname before a public build.
VITE_SITE_URL=
